+static int independent_hp_set_control(struct snd_soc_card *card, const char *name,
+				      bool enumerated, unsigned int value)
+{
+	struct snd_ctl_elem_value control = {};
+	struct snd_kcontrol *kcontrol;
+
+	kcontrol = snd_ctl_find_id_mixer(card->snd_card, name);
+	if (!kcontrol || !kcontrol->put)
+		return -ENOENT;
+
+	if (enumerated) {
+		control.value.enumerated.item[0] = value;
+	} else {
+		control.value.integer.value[0] = value;
+		control.value.integer.value[1] = value;
+	}
+
+	return kcontrol->put(kcontrol, &control) < 0 ? : 0;
+}
+
 static int skl_hda_card_late_probe(struct snd_soc_card *card)
 {
-	return sof_intel_board_card_late_probe(card);
+	int ret;
+
+	ret = sof_intel_board_card_late_probe(card);
+	if (ret)
+		return ret;
+
+	ret = independent_hp_set_control(card, "Independent HP", true, 1);
+	if (ret)
+		return ret;
+
+	return independent_hp_set_control(card, "Headphone Playback Switch", false, 1);
 }
 

+static int independent_hp_append_alt_analog(struct device *dev,
+					     struct snd_soc_card *card,
+					     struct sof_card_private *ctx)
+{
+	struct snd_soc_dai_link *old_links = card->dai_link;
+	struct snd_soc_dai_link *links;
+	struct snd_soc_dai_link *alt;
+	int old_num_links = card->num_links;
+	int i;
+
+	if (!ctx->hda_codec_present)
+		return -ENODEV;
+
+	links = devm_kcalloc(dev, old_num_links + 1, sizeof(*links), GFP_KERNEL);
+	if (!links)
+		return -ENOMEM;
+
+	memcpy(links, old_links, sizeof(*links) * old_num_links);
+
+	if (ctx->codec_link)
+		ctx->codec_link = &links[ctx->codec_link - old_links];
+	if (ctx->amp_link)
+		ctx->amp_link = &links[ctx->amp_link - old_links];
+
+	/* Avoid the topology loader matching "Analog" before "Alt Analog". */
+	for (i = 0; i < old_num_links; i++) {
+		if (!strcmp(links[i].name, "Analog Playback and Capture"))
+			links[i].stream_name = "Analog";
+		else if (!strcmp(links[i].name, "Digital Playback and Capture"))
+			links[i].stream_name = "Digital";
+	}
+
+	alt = &links[old_num_links];
+	alt->name = "Alt Analog Playback and Capture";
+	alt->stream_name = "Alt Analog";
+	alt->cpus = hda_alt_analog_cpus;
+	alt->num_cpus = ARRAY_SIZE(hda_alt_analog_cpus);
+	alt->codecs = hda_alt_analog_codecs;
+	alt->num_codecs = ARRAY_SIZE(hda_alt_analog_codecs);
+	alt->platforms = hda_alt_analog_platforms;
+	alt->num_platforms = ARRAY_SIZE(hda_alt_analog_platforms);
+	alt->id = HDA_ALT_ANALOG_BE_ID;
+	alt->no_pcm = 1;
+
+	card->dai_link = links;
+	card->num_links = old_num_links + 1;
+
+	return 0;
+}
+
 static int skl_hda_audio_probe(struct platform_device *pdev)
 {
@@ -134,5 +222,9 @@ static int skl_hda_audio_probe(struct platform_device *pdev)
 	if (ret)

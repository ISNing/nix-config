-Include.card-init.File "/lib/card-init.conf"
+# The upstream helper clears a mutable per-card cache with rm -rf.  The
+# board-specific copy only needs the directory for DMIC metadata, so create
+# it without deleting existing state.
+Define.LibDir "/var/lib/alsa/card${CardNumber}.conf.d"
+FixedBootSequence [
+	exec "mkdir -p -m 0755 ${var:LibDir}"
+]

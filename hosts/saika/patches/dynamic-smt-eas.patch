+void arch_disable_hybrid_capacity_scale(void)
+{
+	static_branch_disable(&arch_hybrid_cap_scale_key);
+}
+EXPORT_SYMBOL_GPL(arch_disable_hybrid_capacity_scale);
+
+void arch_reenable_hybrid_capacity_scale(void)
+{
+	if (static_branch_unlikely(&arch_hybrid_cap_scale_key))
+		return;
+	/* Memory was already allocated at boot - no alloc needed. */
+	static_branch_enable(&arch_hybrid_cap_scale_key);
+	pr_info("Hybrid CPU capacity scaling enabled\n");
+}
+EXPORT_SYMBOL_GPL(arch_reenable_hybrid_capacity_scale);

+/* ---- dynamic SMT / EAS workqueue ------------------------------ */
+
+static void intel_pstate_smt_work_fn(struct work_struct *work)
+{
+	static bool prev_smt_active = true;
+	bool smt_active = sched_smt_active();
+
+	if (smt_active == prev_smt_active)
+		return;
+	prev_smt_active = smt_active;
+
+	if (smt_active) {
+		arch_disable_hybrid_capacity_scale();
+		sched_set_itmt_support();
+		return;
+	}
+	arch_reenable_hybrid_capacity_scale();
+	hybrid_refresh_cpu_capacity_scaling();
+	sched_clear_itmt_support();
+}
+static DECLARE_DELAYED_WORK(intel_pstate_smt_work, intel_pstate_smt_work_fn);
+
+static void intel_pstate_schedule_smt_check(void)
+{
+	schedule_delayed_work(&intel_pstate_smt_work, msecs_to_jiffies(10));
+}
+
+static int intel_pstate_smt_cpuhp_online(unsigned int cpu)
+{
+	intel_pstate_schedule_smt_check();
+	return 0;
+}
+
+static int intel_pstate_smt_cpuhp_offline(unsigned int cpu)
+{
+	intel_pstate_schedule_smt_check();
+	return 0;
+}
